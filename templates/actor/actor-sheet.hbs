<form class="{{cssClass}}" autocomplete="off">
  <header class="aec-sheet-header">
    <img src="{{actor.img}}" data-edit="img" alt="{{actor.name}}">
    <div class="aec-identity">
      <label>
        <span>{{localize "AETHERCHROME.Name"}}</span>
        <input name="name" type="text" value="{{actor.name}}" {{disabled (not editable)}}>
      </label>
      <label>
        <span>{{localize "AETHERCHROME.Concept"}}</span>
        <input name="system.concept" type="text" value="{{system.concept}}" {{disabled (not editable)}}>
      </label>
    </div>
  </header>

  <section class="aec-panel">
    <div class="aec-section-heading">
      <h2>{{localize "AETHERCHROME.Attributes"}}</h2>
      <span>{{localize "AETHERCHROME.AttributeRangeNote"}}</span>
    </div>
    <div class="aec-attribute-grid">
      {{#each attributes as |attribute|}}
      <div class="aec-attribute-card">
        <div class="aec-attribute-name">
          <strong>{{localize attribute.label}}</strong>
          <span>{{attribute.abbreviation}}</span>
        </div>
        <label>
          <span>{{localize "AETHERCHROME.Base"}}</span>
          <input
            name="system.attributes.{{attribute.key}}.base"
            type="number"
            value="{{attribute.value.base}}"
            min="1"
            {{disabled (not ../editable)}}>
        </label>
        <label>
          <span>{{localize "AETHERCHROME.Current"}}</span>
          <input
            name="system.attributes.{{attribute.key}}.current"
            type="number"
            value="{{attribute.value.current}}"
            min="0"
            {{disabled (not ../editable)}}>
        </label>
      </div>
      {{/each}}
    </div>
  </section>

  <section class="aec-panel">
    <div class="aec-section-heading">
      <h2>{{localize "AETHERCHROME.Skills"}}</h2>
      <span>{{localize "AETHERCHROME.SkillRangeNote"}}</span>
    </div>
    <div class="aec-skill-header" aria-hidden="true">
      <span>{{localize "AETHERCHROME.Use"}}</span>
      <span>{{localize "AETHERCHROME.SkillName"}}</span>
      <span>{{localize "AETHERCHROME.GoverningAttribute"}}</span>
      <span>{{localize "AETHERCHROME.Rating"}}</span>
    </div>
    <div class="aec-skill-list">
      {{#each skills as |skill|}}
      <div class="aec-skill-row">
        <input
          name="system.skills.{{skill.key}}.enabled"
          type="checkbox"
          {{checked skill.enabled}}
          {{disabled (not ../editable)}}>
        <input
          name="system.skills.{{skill.key}}.name"
          type="text"
          value="{{skill.name}}"
          placeholder="{{localize "AETHERCHROME.SkillPlaceholder"}}"
          {{disabled (not ../editable)}}>
        <select
          name="system.skills.{{skill.key}}.attribute"
          {{disabled (not ../editable)}}>
          {{#each ../attributeChoices as |choice|}}
          <option
            value="{{choice.key}}"
            {{#if (eq choice.key skill.attribute)}}selected{{/if}}>
            {{choice.abbreviation}} — {{localize choice.label}}
          </option>
          {{/each}}
        </select>
        <input
          name="system.skills.{{skill.key}}.rating"
          type="number"
          value="{{skill.rating}}"
          min="0"
          max="10"
          {{disabled (not ../editable)}}>
      </div>
      {{/each}}
    </div>
  </section>

  <section class="aec-panel aec-compact-panel">
    <h2>{{localize "AETHERCHROME.Resources"}}</h2>
    <div class="aec-resource-row">
      <label>
        <span>{{localize "AETHERCHROME.HealthCurrent"}}</span>
        <input name="system.resources.health.value" type="number" value="{{system.resources.health.value}}" min="0" {{disabled (not editable)}}>
      </label>
      <span class="aec-slash">/</span>
      <label>
        <span>{{localize "AETHERCHROME.HealthMaximum"}}</span>
        <input name="system.resources.health.max" type="number" value="{{system.resources.health.max}}" min="0" {{disabled (not editable)}}>
      </label>
    </div>
  </section>

  <section class="aec-panel aec-compact-panel">
    <h2>{{localize "AETHERCHROME.Diagnostics"}}</h2>
    <button type="button" data-action="diagnosticRoll">
      <i class="fa-solid fa-dice-d10"></i>
      {{localize "AETHERCHROME.RollDiagnostic"}}
    </button>
    <p>{{localize "AETHERCHROME.DiagnosticNote"}}</p>
  </section>

  <section class="aec-panel aec-notes">
    <h2>{{localize "AETHERCHROME.Notes"}}</h2>
    <textarea name="system.notes" {{disabled (not editable)}}>{{system.notes}}</textarea>
  </section>

  {{#if editable}}
  <footer class="aec-sheet-footer">
    <button type="submit">
      <i class="fa-solid fa-floppy-disk"></i>
      {{localize "AETHERCHROME.Save"}}
    </button>
  </footer>
  {{/if}}
</form>
