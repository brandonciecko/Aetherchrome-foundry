<form class="{{cssClass}}" autocomplete="off">
  <div class="aec-sheet-toolbar">
    <button
      type="button"
      class="aec-edit-toggle{{#if editMode}} is-active{{/if}}"
      data-action="toggleEditMode"
      title="Toggle portrait editing"
      {{disabled (not editable)}}>
      <i class="fa-solid {{#if editMode}}fa-lock-open{{else}}fa-lock{{/if}}"></i>
      Edit
    </button>
    <div class="aec-campaign-badge" title="World campaign profile">
      {{campaign.name}}{{#if campaign.version}} · {{campaign.version}}{{/if}}
    </div>
  </div>

  <header class="aec-sheet-header">
    {{#if portraitEditable}}
    <img src="{{actor.img}}" data-action="editPortrait" alt="{{actor.name}}" class="aec-portrait-editable" title="Click to change portrait">
    {{else}}
    <img src="{{actor.img}}" alt="{{actor.name}}" title="Enable Edit mode to change portrait">
    {{/if}}
    <div class="aec-identity">
      <label><span>{{localize "AETHERCHROME.Name"}}</span>
        <input name="name" type="text" value="{{actor.name}}" {{disabled (not editable)}}>
      </label>
      <label><span>{{localize "AETHERCHROME.Concept"}}</span>
        <input name="system.concept" type="text" value="{{system.concept}}" {{disabled (not editable)}}>
      </label>
    </div>
  </header>

  <section class="aec-panel">
    <div class="aec-section-heading">
      <h2>{{localize "AETHERCHROME.Attributes"}}</h2>
      <span>{{localize "AETHERCHROME.AttributeRangeNote"}}</span>
    </div>
    <div class="aec-attribute-grid">
      {{#each attributes as |attribute|}}
      <div class="aec-attribute-card">
        <div class="aec-attribute-name"><strong>{{localize attribute.label}}</strong><span>{{attribute.abbreviation}}</span></div>
        <label><span>{{localize "AETHERCHROME.Base"}}</span>
          <input name="system.attributes.{{attribute.key}}.base" type="number" value="{{attribute.value.base}}" min="1" max="9" {{disabled (not ../editMode)}}>
        </label>
        <label><span>{{localize "AETHERCHROME.Current"}}</span>
          <input name="system.attributes.{{attribute.key}}.current" type="number" value="{{attribute.value.current}}" min="0" {{disabled (not ../editable)}}>
        </label>
      </div>
      {{/each}}
    </div>
  </section>

  <section class="aec-panel aec-secondary-attributes">
    <div class="aec-section-heading">
      <h2>{{localize "AETHERCHROME.SecondaryAttributes"}}</h2>
      <span>Derived maxima and live resources</span>
    </div>

    <div class="aec-secondary-grid">
      <div class="aec-resource-stepper aec-resource-{{hp.state}}">
        <strong>HP</strong>
        <button type="button" data-action="hpDecrease" aria-label="Decrease HP" {{disabled hp.atMinimum}}>
          <i class="fa-solid fa-minus"></i>
        </button>
        <output aria-label="Current and Maximum HP">{{hp.value}} / {{hp.maximum}}</output>
        <button type="button" data-action="hpIncrease" aria-label="Increase HP" {{disabled hp.atMaximum}}>
          <i class="fa-solid fa-plus"></i>
        </button>
        <small class="aec-hp-threshold-note">
          Low-HP check at {{hp.baseAttribute}} HP or less
          {{#if hp.incapacityDifficulty}} · Current Difficulty {{hp.incapacityDifficulty}}{{/if}}
          {{#if hp.deathCheckInterval}} · Death Check interval {{hp.deathCheckInterval}}{{/if}}
        </small>
      </div>

      <div class="aec-resource-stepper aec-resource-{{mp.state}}">
        <strong>MP</strong>
        <button type="button" data-action="mpDecrease" aria-label="Decrease MP" {{disabled mp.atMinimum}}>
          <i class="fa-solid fa-minus"></i>
        </button>
        <output aria-label="Current and Maximum MP">{{mp.value}} / {{mp.maximum}}</output>
        <button type="button" data-action="mpIncrease" aria-label="Increase MP" {{disabled mp.atMaximum}}>
          <i class="fa-solid fa-plus"></i>
        </button>
        <button type="button" class="aec-effort-button" data-action="openEffortDialog">
          Effort
          {{#if openSkillEffortPending}}<span title="Open Skill Effort pending">S</span>{{/if}}
          {{#if activeDefenseEffortPending}}<span title="Active Defense Effort pending">D</span>{{/if}}
        </button>
      </div>

      <div class="aec-pressure-control">
        <strong>Pressure</strong>
        <button type="button" data-action="pressureDecrease" aria-label="Decrease Pressure" {{disabled pressureAtMinimum}}>
          <i class="fa-solid fa-minus"></i>
        </button>
        <output aria-label="Current Pressure">{{system.resources.pressure}}</output>
        <button type="button" data-action="pressureIncrease" aria-label="Increase Pressure" {{disabled pressureAtMaximum}}>
          <i class="fa-solid fa-plus"></i>
        </button>
      </div>
    </div>
  </section>

  <section class="aec-panel">
    <div class="aec-section-heading">
      <div>
        <h2>{{localize "AETHERCHROME.SkillTree"}}</h2>
        <span>{{localize "AETHERCHROME.SkillTreeNote"}}</span>
      </div>
      <div class="aec-tree-controls">
        <div class="aec-task-search-wrap">
          <input
            class="aec-task-search"
            type="search"
            placeholder="Search Tasks…"
            autocomplete="off"
            data-task-search-input
            aria-label="Search Tasks">
          <div class="aec-task-search-results" data-task-search-results hidden>
            {{#each taskSearchOptions as |task|}}
            <button
              type="button"
              data-task-search-result
              data-task-id="{{task.id}}"
              data-task-name="{{task.name}}"
              data-search-text="{{task.name}} {{task.skillName}} {{task.id}}"
              hidden>
              <strong>{{task.name}}</strong>
              <small>{{task.skillName}} · {{task.id}}</small>
            </button>
            {{/each}}
            <div class="aec-task-search-empty" data-task-search-empty hidden>
              No matching Tasks
            </div>
          </div>
        </div>
        <button type="button" data-action="expandAllSkills">Expand All</button>
        <button type="button" data-action="collapseAllSkills">Collapse All</button>
      </div>
    </div>
    <div class="aec-tree-header">
      <span>{{localize "AETHERCHROME.SkillName"}}</span>
      <span>{{localize "AETHERCHROME.Rating"}}</span>
      <span>{{localize "AETHERCHROME.Task"}}</span>
    </div>
    <div class="aec-skill-tree">
      {{#each skillRows as |skill|}}
      <div class="aec-tree-row{{#if skill.hidden}} aec-tree-row-hidden{{/if}}" data-skill-row-id="{{skill.id}}" style="--aec-depth: {{skill.depth}};">
        <div class="aec-tree-skill" style="padding-left: {{skill.indent}}px;">
          {{#if skill.hasChildren}}
          <button
            type="button"
            class="aec-tree-toggle"
            data-action="toggleSkillBranch"
            data-skill-id="{{skill.id}}"
            aria-label="{{#if skill.expanded}}Collapse{{else}}Expand{{/if}} {{skill.name}}"
            title="{{#if skill.expanded}}Collapse{{else}}Expand{{/if}} {{skill.name}}">
            <i class="fa-solid {{#if skill.expanded}}fa-chevron-down{{else}}fa-chevron-right{{/if}}"></i>
          </button>
          {{else}}
          <span class="aec-tree-toggle-spacer"></span>
          {{/if}}
          <button
            type="button"
            class="aec-skill-name-button"
            data-action="skillDetails"
            data-skill-id="{{skill.id}}"
            title="{{skill.briefDescription}}">
            <strong>{{skill.name}}</strong>
            <small>{{skill.recordType}}</small>
          </button>
        </div>
        <input
          name="system.skillTree.{{skill.key}}.rating"
          type="number"
          value="{{skill.rating}}"
          min="0"
          max="{{skill.maxRating}}"
          data-skill-id="{{skill.id}}"
          data-parent-name="{{skill.parentName}}"
          aria-label="{{skill.name}} rating"
          {{disabled (not ../editable)}}>
        {{#if skill.hasTasks}}
        <div class="aec-task-control">
          <select name="system.skillTree.{{skill.key}}.selectedTask" {{disabled (not ../editable)}}>
            <option value="">{{localize "AETHERCHROME.SelectTask"}}</option>
            {{#each skill.tasks as |task|}}
            <option value="{{task.id}}" {{#if task.selected}}selected{{/if}}>{{task.name}}</option>
            {{/each}}
          </select>
          <button
            type="button"
            data-action="taskDetails"
            data-skill-id="{{skill.id}}"
            title="{{localize "AETHERCHROME.TaskDetailsRoll"}}">
            <i class="fa-solid fa-dice-d10"></i>
          </button>
        </div>
        {{else}}
        <span class="aec-no-tasks">{{localize "AETHERCHROME.NoRegisteredTasks"}}</span>
        {{/if}}
      </div>
      {{/each}}
    </div>
  </section>

  <section class="aec-panel aec-equipment">
    <div class="aec-section-heading">
      <div>
        <h2>Items and Equipment</h2>
        <span>Total carried Load: <strong>{{totalLoad}}</strong></span>
      </div>
    </div>

    <div class="aec-equipment-package">
      <label>
        <span>Alpha Equipment Package</span>
        <select {{disabled (not editable)}}>
          <option value="">Select Package…</option>
          {{#each equipmentPackages as |package|}}
          <option value="{{package.id}}" {{#if package.selected}}selected{{/if}}>
            {{package.name}} — {{package.role}} (Load {{package.totalLoad}})
          </option>
          {{/each}}
        </select>
      </label>
      <button type="button" data-action="applyEquipmentPackage" {{disabled (not editable)}}>
        Apply Package
      </button>
      <label>
        <span>Recorded Package ID</span>
        <input name="system.equipment.packageId" type="text" value="{{system.equipment.packageId}}" readonly>
      </label>
      <label>
        <span>Shield Arm</span>
        <input name="system.equipment.shieldArm" type="text" value="{{system.equipment.shieldArm}}" {{disabled (not editable)}}>
      </label>
      <label>
        <span>Current Encumbrance</span>
        <input type="text" value="{{encumbrance.display}}" readonly>
      </label>
    </div>

    <div class="aec-encumbrance-summary">
      <span><strong>Effective STR:</strong> {{encumbrance.effectiveStrength}}</span>
      <span><strong>None:</strong> 0-{{encumbrance.thresholds.none}}</span>
      <span><strong>Light:</strong> &gt;{{encumbrance.thresholds.none}}-{{encumbrance.thresholds.light}}</span>
      <span><strong>Medium:</strong> &gt;{{encumbrance.thresholds.light}}-{{encumbrance.thresholds.medium}}</span>
      <span><strong>Heavy:</strong> &gt;{{encumbrance.thresholds.medium}}-{{encumbrance.thresholds.heavy}}</span>
      <span><strong>Extreme:</strong> &gt;{{encumbrance.thresholds.heavy}}-{{encumbrance.thresholds.extreme}}</span>
      <span><strong>Overloaded:</strong> &gt;{{encumbrance.thresholds.extreme}}</span>
    </div>

    <div class="aec-inventory-header">
      <span>Item</span>
      <span>Qty</span>
      <span>Load</span>
      <span>Ready</span>
      <span>Carry / Wear</span>
      <span>Resource</span>
      <span>Controls</span>
    </div>

    <div class="aec-inventory-list">
      {{#each inventory as |item|}}
      <div class="aec-inventory-row">
        <div class="aec-inventory-name">
          <img src="{{item.img}}" alt="">
          <span>
            <strong>{{item.name}}</strong>
            <small>{{item.typeLabel}}{{#if item.registryId}} · {{item.registryId}}{{/if}}</small>
          </span>
        </div>

        <div class="aec-inline-stepper">
          <button type="button" data-action="itemQuantityDecrease" data-item-id="{{item.id}}" {{disabled (not ../editable)}}>
            <i class="fa-solid fa-minus"></i>
          </button>
          <output>{{item.quantity}}</output>
          <button type="button" data-action="itemQuantityIncrease" data-item-id="{{item.id}}" {{disabled (not ../editable)}}>
            <i class="fa-solid fa-plus"></i>
          </button>
        </div>

        <span>{{item.aggregateLoad}}</span>

        <button
          type="button"
          class="aec-ready-toggle{{#if item.ready}} is-ready{{/if}}"
          data-action="itemReadyToggle"
          data-item-id="{{item.id}}"
          {{disabled (not ../editable)}}>
          {{#if item.ready}}Ready{{else}}Not Ready{{/if}}
        </button>

        <span>
          {{item.carryLocation}}
          {{#if item.configuration}}<small>{{item.configuration}}</small>{{/if}}
        </span>

        {{#if item.hasResource}}
        <div class="aec-inline-stepper">
          <button type="button" data-action="itemResourceDecrease" data-item-id="{{item.id}}" {{disabled (not ../editable)}}>
            <i class="fa-solid fa-minus"></i>
          </button>
          <output>{{item.resourceValue}} / {{item.resourceMax}} {{item.resourceUnit}}</output>
          <button type="button" data-action="itemResourceIncrease" data-item-id="{{item.id}}" {{disabled (not ../editable)}}>
            <i class="fa-solid fa-plus"></i>
          </button>
        </div>
        {{else}}
        <span>—</span>
        {{/if}}

        <div class="aec-inventory-controls">
          {{#if item.isWeapon}}
          <button type="button" data-action="weaponAttack" data-item-id="{{item.id}}" title="Attack with {{item.name}}">
            <i class="fa-solid fa-crosshairs"></i>
          </button>
          {{#if item.canReload}}
          <button type="button" data-action="weaponReload" data-item-id="{{item.id}}" title="Reload {{item.name}}">
            <i class="fa-solid fa-arrow-rotate-right"></i>
          </button>
          {{/if}}
          {{/if}}
          <button type="button" data-action="itemEdit" data-item-id="{{item.id}}" title="Edit Item">
            <i class="fa-solid fa-pen-to-square"></i>
          </button>
          <button type="button" data-action="itemDelete" data-item-id="{{item.id}}" title="Remove Item" {{disabled (not ../editable)}}>
            <i class="fa-solid fa-trash"></i>
          </button>
        </div>
      </div>
      {{else}}
      <p class="aec-empty-inventory">No embedded equipment. Drag Items onto the Actor or apply an Alpha package.</p>
      {{/each}}
    </div>
  </section>


  <section class="aec-panel aec-notes">
    <h2>{{localize "AETHERCHROME.Notes"}}</h2>
    <textarea name="system.notes" {{disabled (not editable)}}>{{system.notes}}</textarea>
  </section>

  <section class="aec-panel aec-statuses-panel">
    <div class="aec-section-heading">
      <div>
        <h2>Statuses</h2>
        <span>Current Actor Statuses and source-tracked effects</span>
      </div>
      <div class="aec-status-controls">
        <button type="button" data-action="refreshEncumbranceStatuses">
          Refresh Encumbrance Statuses
        </button>
        <button type="button" data-action="statusAdd">Add Status</button>
      </div>
    </div>

    {{#if statuses.length}}
    <div class="aec-status-list">
      {{#each statuses as |status|}}
      <div class="aec-status-row">
        <div class="aec-status-identity">
          <strong>{{status.name}}{{#if status.usesIntensity}} {{status.intensity}}{{/if}}</strong>
          <small>{{status.statusId}} · {{status.sourceDisplay}}{{#if status.locationDisplay}} · {{status.locationDisplay}}{{/if}}</small>
        </div>
        <span class="aec-status-effect">{{status.effect}}</span>
        <div class="aec-status-row-controls">
          {{#if status.usesIntensity}}
          <button type="button" data-action="statusIntensityDecrease" data-status-instance-id="{{status.id}}" {{disabled (not status.removable)}}>−</button>
          <button type="button" data-action="statusIntensityIncrease" data-status-instance-id="{{status.id}}" {{disabled (not status.removable)}}>+</button>
          {{/if}}
          {{#if status.removable}}
          <button type="button" data-action="statusRemove" data-status-instance-id="{{status.id}}" title="Remove {{status.name}}">
            <i class="fa-solid fa-trash"></i>
          </button>
          {{/if}}
        </div>
      </div>
      {{/each}}
    </div>
    {{else}}
    <p class="aec-empty-state">No active Statuses</p>
    {{/if}}
  </section>

  <footer class="aec-sheet-footer">
    <span class="aec-sheet-version">Aetherchrome v{{systemVersion}}</span>
    {{#if editable}}
    <button type="submit"><i class="fa-solid fa-floppy-disk"></i> {{localize "AETHERCHROME.Save"}}</button>
    {{/if}}
  </footer>
</form>
